{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx-build/config.2.0.schema.json",
  "version": "2.0",
  "bundles": {
    "standard-controls-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/standardControls/StandardControlsWebPart.js",
          "manifest": "./src/webparts/standardControls/StandardControlsWebPart.manifest.json"
        }
      ]
    },
    "pnp-controls-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/pnpControls/PnpControlsWebPart.js",
          "manifest": "./src/webparts/pnpControls/PnpControlsWebPart.manifest.json"
        }
      ]
    },
    "advanced-behavior-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/advancedBehavior/AdvancedBehaviorWebPart.js",
          "manifest": "./src/webparts/advancedBehavior/AdvancedBehaviorWebPart.manifest.json"
        }
      ]
    },
    "page-and-accordion-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/pageAndAccordion/PageAndAccordionWebPart.js",
          "manifest": "./src/webparts/pageAndAccordion/PageAndAccordionWebPart.manifest.json"
        }
      ]
    },
    "validation-and-focus-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/validationAndFocus/ValidationAndFocusWebPart.js",
          "manifest": "./src/webparts/validationAndFocus/ValidationAndFocusWebPart.manifest.json"
        }
      ]
    },
    "standard-control-variations-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/standardControlVariations/StandardControlVariationsWebPart.js",
          "manifest": "./src/webparts/standardControlVariations/StandardControlVariationsWebPart.manifest.json"
        }
      ]
    },
    "dynamic-data-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/dynamicData/DynamicDataWebPart.js",
          "manifest": "./src/webparts/dynamicData/DynamicDataWebPart.manifest.json"
        }
      ]
    }
  },
  "externals": {},
  "localizedResources": {
    "StandardControlsWebPartStrings": "lib/webparts/standardControls/loc/{locale}.js",
    "PnpControlsWebPartStrings": "lib/webparts/pnpControls/loc/{locale}.js",
    "PropertyControlStrings": "node_modules/@pnp/spfx-property-controls/lib/loc/{locale}.js"
  }
}
